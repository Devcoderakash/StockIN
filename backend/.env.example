# ==============================================================================
# StockIN — Backend Server Environment Configuration (.env)
# ==============================================================================
# NOTICE:
# These variables are loaded exclusively by the Node.js / Express companion backend.
# They are strictly server-side and are NEVER sent to the client or bundled into JS.
# ==============================================================================

# Server Runtime Configuration
PORT=3001
NODE_ENV=development

# Allowed CORS Origin for Client Requests
FRONTEND_URL=http://localhost:5173

# Supabase Server-side API Connection
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# ==============================================================================
# SERVER ONLY — CRITICAL PRIVILEGED SECRET
# ==============================================================================
# Bypasses Row Level Security (RLS). Used only for privileged administrative operations.
# NEVER commit to Git, NEVER expose to the frontend, NEVER log in responses.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ==============================================================================
# FRONTEND CLIENT CONFIGURATION (Read by Vite from backend/.env)
# ==============================================================================
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

